FROM python:3.11.16-alpine3.24@sha256:0d55920083f1ce1e38ac292e2772f924b4f8bb4188d336c79bf66963039e6146

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONFAULTHANDLER=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apk upgrade --no-cache

RUN addgroup -S -g 10001 novaq \
    && adduser -S -D -H -u 10001 -G novaq -s /sbin/nologin novaq

WORKDIR /app

COPY requirements-production.lock .
RUN python -m pip install --no-cache-dir --no-deps -r requirements-production.lock \
    && python -m pip check \
    && python -m pip uninstall --yes pip setuptools wheel

COPY --chown=novaq:novaq backend backend
COPY --chown=novaq:novaq alembic.ini .
COPY --chown=novaq:novaq migrations migrations

USER 10001:10001
EXPOSE 8000
STOPSIGNAL SIGTERM

CMD ["/bin/sh", "/app/backend/api/entrypoint.sh"]
