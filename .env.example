# NovaQ development template. Production secrets belong in root-owned files
# outside the repository and are mounted by docker-compose.production.yml.

# Required non-secret environment selector.
NOVAQ_ENV=development
# Required by production Compose; use a reviewed commit SHA or release digest.
NOVAQ_RELEASE_ID=local-dev

# PostgreSQL (local defaults only). Production Compose mounts POSTGRES_PASSWORD_FILE.
POSTGRES_USER=novaq
POSTGRES_PASSWORD=novaq
POSTGRES_DB=novaq
DATABASE_HOST=localhost
DATABASE_PORT=5432
# DATABASE_URL and DATABASE_URL_FILE are supported alternatives; set only one.
# DATABASE_URL=
# DATABASE_URL_FILE=
# Production host path consumed by Docker Compose, never by the API directly.
# NOVAQ_DB_PASSWORD_FILE=/secure/novaq/db-password

# Development bootstrap. Production uses NOVAQ_ADMIN_PASSWORD_FILE outside Git.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
# NOVAQ_ADMIN_PASSWORD_FILE=/secure/novaq/admin-bootstrap-password

# Session and browser security.
SESSION_COOKIE_NAME=novaq_session
CSRF_COOKIE_NAME=novaq_csrf
SESSION_TTL_HOURS=24
SECURE_COOKIES=0
ALLOWED_ORIGINS=http://localhost
PUBLIC_APP_URL=http://localhost

# Local development may use console. Production requires SMTP.
EMAIL_DELIVERY_MODE=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=
# Production host path consumed by Docker Compose.
# NOVAQ_SMTP_PASSWORD_FILE=/secure/novaq/smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=1

# Google Identity Services client ID is public; no client secret is used.
GOOGLE_SIGN_IN_ENABLED=0
GOOGLE_CLIENT_ID=

# Authentication token controls.
VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
GOOGLE_NONCE_TTL_MINUTES=5
AUTH_TOKEN_COOLDOWN_SECONDS=60
AUTH_TOKEN_HOURLY_LIMIT=5

# Upload and stored-result bounds.
MAX_UPLOAD_BYTES=5242880
XLSX_MAX_UNCOMPRESSED_BYTES=52428800
XLSX_MAX_ZIP_MEMBERS=1000
XLSX_MAX_COMPRESSION_RATIO=100
XLSX_MAX_WORKSHEETS=20
UPLOAD_MAX_ROWS=100000
UPLOAD_MAX_COLUMNS=100
UPLOAD_MAX_CELL_CHARS=32768
UPLOAD_MAX_DATAFRAME_BYTES=104857600
RESULT_JSONB_MAX_BYTES=524288
ARTIFACT_ROOT=

# Bounded PostgreSQL pool.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5

# Initial single-host runtime. Production validates API_WORKERS=1.
API_WORKERS=1
API_LIMIT_CONCURRENCY=32
API_GRACEFUL_SHUTDOWN_SECONDS=30
FORWARDED_ALLOW_IPS=127.0.0.1

# Application limiter; the trusted TLS edge remains the primary IP limiter.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_REPORT=10
RATE_LIMIT_COMPUTE=30
RATE_LIMIT_ADMIN=30
