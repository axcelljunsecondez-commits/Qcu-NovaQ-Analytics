FROM python:3.11.14-slim-trixie@sha256:c8271b1f627d0068857dce5b53e14a9558603b527e46f1f901722f935b786a39

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONFAULTHANDLER=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get upgrade --yes \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 novaq \
    && useradd --uid 10001 --gid novaq --create-home --shell /usr/sbin/nologin novaq

WORKDIR /app

COPY requirements-production.lock .
RUN python -m pip install --no-cache-dir --no-deps -r requirements-production.lock \
    && python -m pip check \
    && python -m pip uninstall --yes pip setuptools wheel

COPY --chown=novaq:novaq backend backend
COPY --chown=novaq:novaq alembic.ini .
COPY --chown=novaq:novaq migrations migrations

USER 10001:10001
EXPOSE 8000
STOPSIGNAL SIGTERM

CMD ["/bin/sh", "/app/backend/api/entrypoint.sh"]
